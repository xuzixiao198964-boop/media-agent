DATABASE_URL=postgresql+asyncpg://media:media@localhost:5432/media_agent
# 与宿主机其它 Celery 共存时改用 /1 等独立 DB，避免队列混用
REDIS_URL=redis://localhost:6379/1
# 可选；留空则自动使用项目根下 frontend/dist（与 uvicorn 同端口提供网页）
# FRONTEND_DIST_DIR=
SECRET_KEY=replace-with-long-random
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
# 口播+背景音乐 / 纯背景音乐 模式需要服务器上可读的音频文件（如 mp3）
# DEFAULT_BGM_PATH=/data/bgm/default.mp3
CORS_ORIGINS=*

# 可选 AI 密钥（也可在前端登录后在「API」页写入数据库加密存储）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

PUBLISH_MODE=mock

# ---------- 邮件（QQ 邮箱等 SMTP，用于注册/登录/重置密码验证码）----------
# 留空则不发真实邮件，仅写入 flow_logs。详见 docs/SMTP与腾讯云短信.md
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=你的QQ号@qq.com
# SMTP_PASSWORD=QQ邮箱授权码（非QQ密码）
# SMTP_FROM=你的QQ号@qq.com
# SMTP_USE_TLS=true

# ---------- 短信（需对接腾讯云等；当前仅作占位，见 docs/SMTP与腾讯云短信.md）----------
# SMS_PROVIDER=
