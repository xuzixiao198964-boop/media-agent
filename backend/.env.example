# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/media_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Rate Limiting
LOGIN_ATTEMPTS_PER_IP=5
LOGIN_ATTEMPTS_PER_USER=3
LOGIN_BLOCK_TIME_MINUTES=15

# File Upload
MAX_UPLOAD_SIZE=2147483648  # 2GB in bytes
CHUNK_SIZE=5242880  # 5MB in bytes
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,flv,wmv,webm,mpeg,mpg

# Storage Paths
VIDEO_STORAGE_PATH=/var/media/videos
TEMP_STORAGE_PATH=/var/media/temp
THUMBNAIL_STORAGE_PATH=/var/media/thumbnails
PROCESSED_STORAGE_PATH=/var/media/processed

# AI Services
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# TTS Services
AZURE_TTS_KEY=your_azure_tts_key_here
GOOGLE_TTS_KEY=your_google_tts_key_here

# Platform APIs
YOUTUBE_API_KEY=your_youtube_api_key_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
BILIBILI_ACCESS_TOKEN=your_bilibili_access_token_here

# Application
DEBUG=false
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001